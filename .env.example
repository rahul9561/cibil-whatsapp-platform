# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
LOG_LEVEL=INFO
# json (prod) or console (dev)
LOG_FORMAT=console

# --- MySQL ---
MYSQL_DATABASE=cibil
MYSQL_USER=cibil
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# Inside docker compose the host is "mysql"
DATABASE_URL=mysql://cibil:change-me@mysql:3306/cibil

# --- Redis / Celery ---
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379/0
CELERY_BROKER_URL=redis://:change-me-redis@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-me-redis@redis:6379/2

# --- Encryption keys (required) ---
# Fernet keys, comma-separated, NEWEST FIRST. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: prepend a new key, restart, run `manage.py rotate_encryption_keys`, then drop the old key.
FIELD_ENCRYPTION_KEYS=change-me
# Separate secret (>= 32 chars) for searchable hashes of phone/PAN. Never rotate casually: it re-keys all lookups.
BLIND_INDEX_KEY=change-me
# REPORT_FILE_ENCRYPTION_KEY=   (Phase 4)

# --- Auth ---
# TRUSTED_PROXY_COUNT=1          set to 1 behind nginx so client IPs are logged correctly
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_SECONDS=900
# OTP_TOTP_ISSUER=CIBIL Admin

# --- Integrations (later phases; leave empty to use mock adapters) ---
# CREDIT_PROVIDER=mock
# RAZORPAY_KEY_ID=
