# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
LOG_LEVEL=INFO
# json (prod) or console (dev)
LOG_FORMAT=console

# --- MySQL ---
MYSQL_DATABASE=cibil
MYSQL_USER=cibil
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# Inside docker compose the host is "mysql"
DATABASE_URL=mysql://cibil:change-me@mysql:3306/cibil

# --- Redis / Celery ---
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379/0
CELERY_BROKER_URL=redis://:change-me-redis@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-me-redis@redis:6379/2

# --- Encryption keys (required) ---
# Fernet keys, comma-separated, NEWEST FIRST. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: prepend a new key, restart, run `manage.py rotate_encryption_keys`, then drop the old key.
FIELD_ENCRYPTION_KEYS=change-me
# Separate secret (>= 32 chars) for searchable hashes of phone/PAN. Never rotate casually: it re-keys all lookups.
BLIND_INDEX_KEY=change-me
# AES-256-GCM keys for report PDFs: "id:base64(32 bytes)", comma-separated, CURRENT FIRST. Generate with:
#   python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
REPORT_FILE_ENCRYPTION_KEYS=k1:change-me

# --- Auth ---
# TRUSTED_PROXY_COUNT=1          set to 1 behind nginx so client IPs are logged correctly
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_SECONDS=900
# OTP_TOTP_ISSUER=CIBIL Admin

# --- Business rules (confirm before go-live) ---
# REPORT_PRICE_PAISE=9900          required in production; dev defaults to 9900 as a placeholder
# REPORT_VALIDITY_DAYS=7
# REPORT_PDF_RETENTION_DAYS=30
# OTP_MAX_ATTEMPTS=3
# OTP_MAX_RESENDS=2
# PAYMENT_LINK_EXPIRY_HOURS=72
# FOLLOWUP_REMINDER_OFFSETS_HOURS=1,24,72
# WA_TEMPLATE_PAYMENT_LINK=payment_link_v1
# WA_TEMPLATE_PAYMENT_REMINDER=payment_reminder_v1
# WA_TEMPLATE_REPORT_DELIVERY=report_delivery_v1

# --- Integrations: "mock" in dev (default); real adapters arrive in Phases 6, 7 and 10 ---
# Mock adapters are refused when DJANGO_DEBUG is false unless ALLOW_MOCK_ADAPTERS=true.
# CREDIT_PROVIDER=mock
# PAYMENT_GATEWAY=mock
# WHATSAPP_GATEWAY=mock
# Razorpay (set PAYMENT_GATEWAY=razorpay). Use rzp_test_ keys until go-live; live keys are refused with DEBUG on.
# The webhook secret is the one entered in Razorpay Dashboard > Webhooks for https://<domain>/webhooks/razorpay
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
