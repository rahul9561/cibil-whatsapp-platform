# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:8080
LOG_LEVEL=INFO
# json (prod) or console (dev)
LOG_FORMAT=console

# --- MySQL ---
MYSQL_DATABASE=cibil
MYSQL_USER=cibil
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# Inside docker compose the host is "mysql"
DATABASE_URL=mysql://cibil:change-me@mysql:3306/cibil

# --- Redis / Celery ---
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379/0
CELERY_BROKER_URL=redis://:change-me-redis@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-me-redis@redis:6379/2

# --- Encryption keys (required) ---
# Fernet keys, comma-separated, NEWEST FIRST. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: prepend a new key, restart, run `manage.py rotate_encryption_keys`, then drop the old key.
FIELD_ENCRYPTION_KEYS=change-me
# Separate secret (>= 32 chars) for searchable hashes of phone/PAN. Never rotate casually: it re-keys all lookups.
BLIND_INDEX_KEY=change-me
# AES-256-GCM keys for report PDFs: "id:base64(32 bytes)", comma-separated, CURRENT FIRST. Generate with:
#   python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
REPORT_FILE_ENCRYPTION_KEYS=k1:change-me

# --- Auth ---
# TRUSTED_PROXY_COUNT=1          set to 1 behind nginx so client IPs are logged correctly
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_SECONDS=900
# OTP_TOTP_ISSUER=CIBIL Admin

# --- Business rules (confirm before go-live) ---
# REPORT_PRICE_PAISE=9900          required in production; dev defaults to 9900 as a placeholder
# REPORT_VALIDITY_DAYS=7
# REPORT_PDF_RETENTION_DAYS=30
# OTP_MAX_ATTEMPTS=3
# OTP_MAX_RESENDS=2
# PAYMENT_LINK_EXPIRY_HOURS=72
# FOLLOWUP_REMINDER_OFFSETS_HOURS=1,24,72
# STALE_REQUEST_MINUTES=60           unfinished details/consent/OTP expire after this much silence
# FOLLOWUP_ESCALATE_AFTER_HOURS=48    unpaid this long and...
# FOLLOWUP_ESCALATE_QUIET_HOURS=24    ...no staff note this long -> escalate (one level per quiet period)
# FOLLOWUP_MAX_ESCALATION=3
# REMINDER_DISPATCH_BATCH=100
# WA_TEMPLATE_PAYMENT_LINK=payment_link_v1
# WA_TEMPLATE_PAYMENT_REMINDER=payment_reminder_v1
# WA_TEMPLATE_REPORT_DELIVERY=report_delivery_v1

# --- Integrations: "mock" in dev (default); real adapters arrive in Phases 6, 7 and 10 ---
# Mock adapters are refused when DJANGO_DEBUG is false unless ALLOW_MOCK_ADAPTERS=true.
# CREDIT_PROVIDER=mock               mock (OTP flow) | mock_no_otp (behaves like Surepass) | surepass
# PAYMENT_GATEWAY=mock
# WHATSAPP_GATEWAY=mock
# Razorpay (set PAYMENT_GATEWAY=razorpay). Use rzp_test_ keys until go-live; live keys are refused with DEBUG on.
# The webhook secret is the one entered in Razorpay Dashboard > Webhooks for https://<domain>/webhooks/razorpay
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# WhatsApp Cloud API (set WHATSAPP_GATEWAY=cloud_api). Webhook URL: https://<domain>/webhooks/whatsapp
# WHATSAPP_GRAPH_VERSION=v21.0        check Meta's current version before go-live
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=              a long-lived System User token, not a 24-hour test token
# WHATSAPP_APP_SECRET=                Meta app secret: verifies X-Hub-Signature-256 on every webhook
# WHATSAPP_VERIFY_TOKEN=              any random string; enter the same value in Meta's webhook setup
# WHATSAPP_INBOUND_BODY_TTL=300       seconds a message body may wait in Redis (it may be an OTP)

# --- Production only (.env.prod; see docs/RUNBOOK.md) ---
# DOMAIN=reports.example.com          nginx server_name and TLS certificate name
# DJANGO_ALLOWED_HOSTS=reports.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://reports.example.com
# TRUSTED_PROXY_COUNT=1               nginx in front (default in production settings)
# IMAGE_TAG=v1.0.0                    release tag for images (default: latest)
# GUNICORN_WORKERS=3
# CELERY_CONCURRENCY=4
# DJANGO_HSTS_PRELOAD=false           only enable once you are sure about HTTPS on every subdomain
# SENTRY_DSN=                         optional error reporting (PII is stripped before sending)
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Surepass credit reports (CREDIT_PROVIDER=surepass) ---
# SUREPASS_API_TOKEN=                 Bearer token from Surepass (never commit it)
# SUREPASS_BASE_URL=https://app.surepass.app
# SUREPASS_PDF_HOSTS=amazonaws.com    hosts the report PDF link may point to
# PREFILL_BY_MOBILE=true              customer sends only "Hi": name/PAN/gender looked up from their number
# SUREPASS_KYC_BASE_URL=https://kyc-api.surepass.app   prefill-by-mobile host
# SUREPASS_PREFILL_TOKEN=             only if prefill uses a different token (defaults to SUREPASS_API_TOKEN)
# PREFILL_MAX_PER_DAY=3               paid lookups per WhatsApp number per day
# PAN_GUARD_DAYS=30                   no-OTP providers: block a PAN on another number / another PAN on the
#                                     same number within this many days (0 disables)
