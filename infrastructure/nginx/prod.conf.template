# Production nginx. Rendered by the nginx image from /etc/nginx/templates (only ${DOMAIN} is substituted).
# TLS certificates come from Let's Encrypt on the host (see scripts/init-letsencrypt.sh and docs/RUNBOOK.md).

# --- Privacy: never log query strings (search terms), referrers or user agents. ---
log_format privacy '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent '
                   '$request_time rid=$request_id';
# access_log is set inside each server block: that replaces the image's default "main" log (which includes
# query strings). Declaring it here at http level would add a second log instead of replacing it.

# --- Rate limits (per client IP). Login is the brute-force target; webhooks get headroom for bursts. ---
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=webhooks:10m rate=30r/s;
limit_req_status 429;

map $uri $cache_control {
    ~^/assets/   "public, max-age=31536000, immutable";
    ~^/static/   "public, max-age=31536000, immutable";
    default      "no-cache";
}

upstream django {
    server web:8100;
    keepalive 16;
}

server_tokens off;

# HTTP: only the ACME challenge; everything else goes to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};
    access_log /var/log/nginx/access.log privacy;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};
    access_log /var/log/nginx/access.log privacy;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 1m;
    client_body_timeout 15s;
    send_timeout 30s;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cache-Control $cache_control always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_id;
    proxy_read_timeout 60s;

    location = /api/v1/auth/login {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://django;
    }
    location /api/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://django;
    }
    location /webhooks/ {
        limit_req zone=webhooks burst=60 nodelay;
        client_max_body_size 512k;
        proxy_pass http://django;
    }
    location /django-admin/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://django;
    }
    location /static/ {
        proxy_pass http://django;
    }
    location = /healthz {
        access_log off;
        proxy_pass http://django;
    }
    # Readiness reveals dependency state: not public. Check it inside the stack instead
    # (docs/RUNBOOK.md: `docker compose exec web python -c ...readyz`).
    location = /readyz {
        deny all;
    }

    root /usr/share/nginx/html;
    location /assets/ {
        try_files $uri =404;
    }
    location / {
        try_files $uri /index.html;
    }
}
